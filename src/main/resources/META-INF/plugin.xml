<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.codersanket24.mycpassistant</id>
    <name>MyCPAssistant</name>
    <vendor url="https://github.com/CoderSanket24">codersanket24</vendor>

    <description><![CDATA[
        <p><b>MyCPAssistant</b> &mdash; A Competitive Programming companion plugin for IntelliJ IDEA.</p>
        <ul>
            <li>Listens for problem data from the <b>Competitive Companion</b> browser extension.</li>
            <li>Auto-generates solution files and test cases in your configured output directory.</li>
            <li>Fully customisable: output path, file extension, listener port, and code template with placeholders.</li>
            <li>Manual file creation via <b>Tools &rarr; Create CP File</b> (<code>Ctrl+Alt+N</code>).</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">

        <!-- Application-level persistent settings -->
        <applicationService
            serviceImplementation="com.github.codersanket24.mycpassistant.settings.AppSettingsState"/>

        <!-- Settings page: Settings > Tools > Custom CP Companion -->
        <applicationConfigurable
            parentId="tools"
            id="com.github.codersanket24.mycpassistant.settings.AppSettingsConfigurable"
            displayName="Custom CP Companion"
            instance="com.github.codersanket24.mycpassistant.settings.AppSettingsConfigurable"/>

        <!-- Project-level service: owns the HTTP server lifecycle -->
        <projectService
            serviceImplementation="com.github.codersanket24.mycpassistant.server.CompanionServerService"/>

        <!-- ProjectActivity: starts the server when a project opens -->
        <postStartupActivity
            implementation="com.github.codersanket24.mycpassistant.startup.CompanionServerStartupActivity"/>

        <!-- Notification group for balloon messages -->
        <notificationGroup
            id="MyCPAssistant"
            displayType="BALLOON"
            isLogByDefault="true"/>

    </extensions>

    <actions>
        <!-- Manual trigger: Tools > Create CP File -->
        <action
            id="MyCPAssistant.CreateCPFile"
            class="com.github.codersanket24.mycpassistant.actions.CreateCPFileAction"
            text="Create CP File"
            description="Manually create a Competitive Programming solution file">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default"      first-keystroke="ctrl alt N"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt N"/>
        </action>
    </actions>

</idea-plugin>
